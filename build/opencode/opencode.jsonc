{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "options": {
            "provider": {
              "order": [
                "z-ai",
                "novita"
              ],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "rg": "allow",
