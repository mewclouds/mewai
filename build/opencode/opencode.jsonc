      "gh run view *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "git commit": "ask",
      "git commit *": "ask",
      "* git commit": "ask",
      "* git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "* git push": "ask",
      "* git push *": "ask",
      "git tag": "ask",
