{
  "shell": [
    {
      "id": "history-rewrite",
      "tier": "forbid",
      "why": "Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
      "tokens": [
        "git push --force",
        "git push -f",
        "git push --force-with-lease",
        "git reset --hard",
        "git clean",
        "git rebase --interactive",
        "git filter-branch"
      ],
      "globs": [
        "git push * --force*",
        "git push * -f",
        "git push * -f *"
      ]
    },
    {
      "id": "discard-work",
      "tier": "forbid",
      "why": "These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
      "tokens": [
        "git checkout --",
        "git restore --staged --worktree",
        "git stash drop",
        "git stash clear",
        "git branch -D"
      ],
      "globs": []
    },
    {
      "id": "remote-destruction",
      "tier": "forbid",
      "why": "Deleting a remote repository or release is never an incidental development action. Do it by hand after verifying the exact target.",
      "tokens": [
        "gh repo delete",
        "gh release delete",
        "gh cache delete"
      ],
      "globs": []
    },
    {
      "id": "recursive-delete",
      "tier": "forbid",
      "why": "A recursive force delete with a wrong or empty variable in the path is unrecoverable.",
      "tokens": [
        "rm -rf",
        "rm -fr"
      ],
      "globs": [
        "Remove-Item *-?ecurse*",
        "rm *-?ecurse*",
        "ri *-?ecurse*",
        "rd *-?ecurse*",
        "del *-?ecurse*"
      ]
    },
    {
      "id": "publish-and-share",
      "tier": "confirm",
      "why": "Pushing, publishing, and messaging are visible to other people the moment they run, and approval for one does not carry to the next.",
      "tokens": [
        "git push",
        "git commit",
        "git tag",
        "git remote",
        "gh pr create",
        "gh pr merge",
        "gh pr close",
        "gh issue create",
        "gh issue close",
        "gh release create",
        "gh workflow run",
        "npm publish",
        "cargo publish",
        "docker push"
      ],
      "globs": []
    },
    {
      "id": "dependency-mutation",
      "tier": "confirm",
      "why": "Installing packages runs third-party install scripts and rewrites lockfiles that the rest of the project depends on.",
      "tokens": [
        "npm install",
        "npm i",
        "pnpm add",
        "yarn add",
        "pip install",
        "cargo install"
      ],
      "globs": []
    }
  ],
  "read": [
    {
      "id": "secret-files",
      "tier": "forbid",
      "why": "Reading a credential into the transcript exposes it to the model provider and to anyone the transcript is later shared with.",
      "patterns": [
        ".env",
        ".env.*",
        "**/.env",
        "**/*.pem",
        "**/id_rsa",
        "**/id_ed25519",
        "~/.ssh/**",
        "~/.aws/credentials",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json"
      ]
    }
  ]
}
