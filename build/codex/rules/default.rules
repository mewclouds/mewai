# Rendered by mewai from core/policy/policy.json. Do not edit this file.
# Change the policy and run scripts/render.ps1.
#
# Rules control which commands Codex may run outside the sandbox.
# Behavioral expectations belong in AGENTS.md. Do not blanket-allow shells,
# wrappers, or tools that can hide arbitrary commands.

# history-rewrite: These rewrite or wipe local history. Inspect and make a focused reversible change instead.
prefix_rule(
    pattern=["git", "clean"],
    decision="forbidden",
    justification="These rewrite or wipe local history. Inspect and make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "rebase", "--interactive"],
    decision="forbidden",
    justification="These rewrite or wipe local history. Inspect and make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "filter-branch"],
    decision="forbidden",
    justification="These rewrite or wipe local history. Inspect and make a focused reversible change instead.",
)

# discard-work: These throw away uncommitted work with no undo. Inspect and revert exact files instead.
prefix_rule(
    pattern=["git", "restore", "--staged", "--worktree"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)
prefix_rule(
    pattern=["git", "stash", "drop"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)
prefix_rule(
    pattern=["git", "stash", "clear"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)

# remote-destruction: Deleting a remote release or cache is never an incidental development action. Do it by hand after verifying the exact target.
prefix_rule(
    pattern=["gh", "release", "delete"],
    decision="forbidden",
    justification="Deleting a remote release or cache is never an incidental development action. Do it by hand after verifying the exact target.",
)
prefix_rule(
    pattern=["gh", "cache", "delete"],
    decision="forbidden",
    justification="Deleting a remote release or cache is never an incidental development action. Do it by hand after verifying the exact target.",
)

# local-commit: A commit is the user's record of the work. Draft the message. Do not run git commit.
prefix_rule(
    pattern=["git", "commit"],
    decision="prompt",
    justification="A commit is the user's record of the work. Draft the message. Do not run git commit.",
)

# publish-and-share: Opening, merging, and closing work on GitHub is visible to other people the moment it runs, and approval for one does not carry to the next.
prefix_rule(
    pattern=["gh", "pr", "create"],
    decision="prompt",
    justification="Opening, merging, and closing work on GitHub is visible to other people the moment it runs, and approval for one does not carry to the next.",
)
prefix_rule(
    pattern=["gh", "pr", "merge"],
    decision="prompt",
    justification="Opening, merging, and closing work on GitHub is visible to other people the moment it runs, and approval for one does not carry to the next.",
)
prefix_rule(
    pattern=["gh", "pr", "close"],
    decision="prompt",
    justification="Opening, merging, and closing work on GitHub is visible to other people the moment it runs, and approval for one does not carry to the next.",
)
prefix_rule(
    pattern=["gh", "issue", "create"],
    decision="prompt",
    justification="Opening, merging, and closing work on GitHub is visible to other people the moment it runs, and approval for one does not carry to the next.",
)
prefix_rule(
    pattern=["gh", "issue", "close"],
    decision="prompt",
    justification="Opening, merging, and closing work on GitHub is visible to other people the moment it runs, and approval for one does not carry to the next.",
)
prefix_rule(
    pattern=["gh", "release", "create"],
    decision="prompt",
    justification="Opening, merging, and closing work on GitHub is visible to other people the moment it runs, and approval for one does not carry to the next.",
)
