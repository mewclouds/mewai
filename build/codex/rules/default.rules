# Rules control which commands Codex may run outside the sandbox.
# Behavioral expectations belong in AGENTS.md. Do not blanket-allow shells,
# wrappers, or tools that can hide arbitrary commands.

# read-only-inspection: Inspection changes nothing, so approving it only costs attention.
prefix_rule(
    pattern=["rg"],
    decision="allow",
)
prefix_rule(
    pattern=["fd"],
    decision="allow",
)
prefix_rule(
    pattern=["ls"],
    decision="allow",
)
prefix_rule(
    pattern=["cat"],
    decision="allow",
)
prefix_rule(
    pattern=["head"],
    decision="allow",
)
prefix_rule(
    pattern=["tail"],
    decision="allow",
)
prefix_rule(
    pattern=["wc"],
    decision="allow",
)
prefix_rule(
    pattern=["sort"],
    decision="allow",
)
prefix_rule(
    pattern=["uniq"],
    decision="allow",
)
prefix_rule(
    pattern=["jq"],
    decision="allow",
)
prefix_rule(
    pattern=["git", "status"],
    decision="allow",
)
prefix_rule(
    pattern=["git", "diff"],
    decision="allow",
)
prefix_rule(
    pattern=["git", "log"],
    decision="allow",
)
prefix_rule(
    pattern=["git", "show"],
    decision="allow",
)
prefix_rule(
    pattern=["git", "branch"],
    decision="allow",
)
prefix_rule(
    pattern=["git", "rev-parse"],
    decision="allow",
)
prefix_rule(
    pattern=["git", "ls-files"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "pr", "view"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "pr", "list"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "pr", "checks"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "pr", "diff"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "issue", "view"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "issue", "list"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "repo", "view"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "run", "view"],
    decision="allow",
)
prefix_rule(
    pattern=["gh", "run", "list"],
    decision="allow",
)

# history-rewrite: Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.
prefix_rule(
    pattern=["git", "push", "--force"],
    decision="forbidden",
    justification="Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "push", "-f"],
    decision="forbidden",
    justification="Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "push", "--force-with-lease"],
    decision="forbidden",
    justification="Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "reset", "--hard"],
    decision="forbidden",
    justification="Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "clean"],
    decision="forbidden",
    justification="Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "rebase", "--interactive"],
    decision="forbidden",
    justification="Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
)
prefix_rule(
    pattern=["git", "filter-branch"],
    decision="forbidden",
    justification="Recovering a force-pushed branch or a hard reset is manual and error prone. Make a focused reversible change instead.",
)

# discard-work: These throw away uncommitted work with no undo. Inspect and revert exact files instead.
prefix_rule(
    pattern=["git", "checkout", "--"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)
prefix_rule(
    pattern=["git", "restore", "--staged", "--worktree"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)
prefix_rule(
    pattern=["git", "stash", "drop"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)
prefix_rule(
    pattern=["git", "stash", "clear"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)
prefix_rule(
    pattern=["git", "branch", "-D"],
    decision="forbidden",
    justification="These throw away uncommitted work with no undo. Inspect and revert exact files instead.",
)

# remote-destruction: Deleting a remote repository or release is never an incidental development action. Do it by hand after verifying the exact target.
prefix_rule(
    pattern=["gh", "repo", "delete"],
    decision="forbidden",
    justification="Deleting a remote repository or release is never an incidental development action. Do it by hand after verifying the exact target.",
)
prefix_rule(
    pattern=["gh", "release", "delete"],
    decision="forbidden",
    justification="Deleting a remote repository or release is never an incidental development action. Do it by hand after verifying the exact target.",
)
prefix_rule(
    pattern=["gh", "cache", "delete"],
    decision="forbidden",
    justification="Deleting a remote repository or release is never an incidental development action. Do it by hand after verifying the exact target.",
)

# recursive-delete: A recursive force delete with a wrong or empty variable in the path is unrecoverable.
prefix_rule(
    pattern=["rm", "-rf"],
    decision="forbidden",
    justification="A recursive force delete with a wrong or empty variable in the path is unrecoverable.",
)
prefix_rule(
    pattern=["rm", "-fr"],
    decision="forbidden",
    justification="A recursive force delete with a wrong or empty variable in the path is unrecoverable.",
)
